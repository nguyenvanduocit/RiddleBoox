<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        The writer's books live in shared storage as ordinary files
        (/sdcard/Books/*.epub). All-files access is what opens them, and it is
        not granted by a dialog: the user turns it on under Settings > Apps >
        Special access > All files access, or it is set once over adb with
        `appops set` (a double dash before `uid` cannot be written inside an
        XML comment; see README).

        Without it the diary still knows every book on the device, how far the
        writer has read and everything they marked — all of that comes from the
        reader's own database below, which needs no file access. Only reading
        the words inside a book stops working.

        READ_EXTERNAL_STORAGE and WRITE_EXTERNAL_STORAGE are declared alongside
        it because on at least one Android 11 device the special access grant
        alone was not enough: `Environment.isExternalStorageManager()`
        reported true while every `java.io.File`/`ZipFile` open on a book
        still threw a permission denial, until BOTH runtime permissions were
        also granted — and even then only after the app's process restarted,
        since the storage FUSE layer resolves an app's access group once, at
        process start. [showOnboardingPermissionOverlay] and Settings' "check"
        row ask for both alongside the all-files-access screen, and tell the
        writer to close and reopen the diary once granted.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!--
        NeoReader publishes its library — books, highlights, bookmarks — as an
        exported content provider under this authority, and asks for no
        permission to read it. Package visibility filtering still applies: an
        app targeting API 30 or later cannot see a provider in a package it has
        not named, and ContentResolver.query returns null rather than failing,
        so leaving this out looks like a reader with an empty shelf.
    -->
    <queries>
        <package android:name="com.onyx" />
        <package android:name="com.onyx.kreader" />
        <provider android:authorities="com.onyx.content.database.ContentProvider" />
        <provider android:authorities="com.onyx.android.sdk.note.ContentProvider" />
        <provider android:authorities="com.onyx.android.sdk.shape.ContentProvider" />
    </queries>

    <application
        android:name=".RiddleBooxApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        tools:replace="android:allowBackup">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".settings.SettingsActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <!--
            Not started from anywhere yet — see LockActivity.kt's class doc.
            Registered ahead of being wired so the screen builds and packages
            on its own; MainActivity does not hold this Activity's class name.
        -->
        <activity
            android:name=".settings.LockActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".AgentsActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".BookPickerActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false" />
        <activity
            android:name=".settings.PairActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false" />
        <activity
            android:name=".MemoriesActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false" />
        <activity
            android:name=".history.HistoryActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false" />
        <activity
            android:name=".history.TranscriptActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.onyx.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
